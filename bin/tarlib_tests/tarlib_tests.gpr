with "aunit";
with "project_tools";
with "tarlib";

project Tarlib_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & external ("ALIRE_BUILD_PROFILE", "development");
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tarlib_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Tarlib_Tests;
